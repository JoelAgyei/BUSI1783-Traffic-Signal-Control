  <tag k="check_date" v="2025-05-20"/>
  <tag k="colour" v="#51276f"/>
  <tag k="description" v="A circular walkway to celebrate Queen Elizabeth II's Platinum Jubilee marked by pavement bronze plaques at 20 points of special significance to the people of Birmingham. Unveiled by HRH The Earl of Wessex."/>
  <tag k="distance" v="19 km"/>
  <tag k="educational" v="yes"/>
  <tag k="from" v="Centenary Square"/>
  <tag k="image" v="https://commonwealthwalkway.info/wp-content/uploads/2022/02/PJW-marker.png"/>
  <tag k="name" v="Birmingham Platinum Jubilee Walkway"/>
  <tag k="network" v="lwn"/>
  <tag k="network:type" v="lwn"/>
  <tag k="operator" v="Birmingham City Council;University of Birmingham;Canal and River Trust;West Midlands Combined Authority;Commonwealth Games Federation"/>
  <tag k="ref" v="PJW"/>
  <tag k="roundtrip" v="yes"/>
  <tag k="route" v="foot"/>
  <tag k="source" v="https://commonwealthwalkway.info/2022/06/hrh-the-earl-of-wessex-unveils-birminghams-platinum-jubilee-walkway%EF%BF%BC/"/>
  <tag k="start_date" v="2022-06-17"/>
  <tag k="to" v="Centenary Square"/>
  <tag k="tourism" v="yes"/>
  <tag k="type" v="route"/>
  <tag k="via" v="Hall of Memory;Museum/Art Gallery;Assay Office;Museum of JQ;Chamberlain Clock;Pen Museum;Coffin Works;Black Sabbath Bench;Worcs/Birm Canal;UoB;Barber Inst.;Wildlife Cons Pk;MAC;Edgbaston Cricket Grnd;Highgate Bap Church;Hippodrome;Bullring;St Phillip Cath"/>
